---
// src/components/layout/Footer.astro
//
// Pie de pagina: logo + descripcion, enlaces rapidos, servicios,
// contacto/redes sociales, y barra de copyright al final.

import Logo from '../ui/Logo.astro';

const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: '#hero', label: 'Inicio' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#portafolio', label: 'Portafolio' },
  { href: '#testimonios', label: 'Testimonios' },
  { href: '#contacto', label: 'Contacto' },
];

const services = ['Bodas', 'Cumpleaños', 'Eventos corporativos', 'Reuniones sociales'];

const socials = [
  {
    label: 'Instagram',
    href: 'https://instagram.com',
    path: 'M12 2c2.7 0 3.05.01 4.12.06 1.07.05 1.79.22 2.43.46.66.26 1.21.6 1.76 1.15.5.5.9 1.1 1.15 1.76.24.64.41 1.36.46 2.43.05 1.07.06 1.42.06 4.12s-.01 3.05-.06 4.12c-.05 1.07-.22 1.79-.46 2.43a4.9 4.9 0 0 1-1.15 1.76 4.9 4.9 0 0 1-1.76 1.15c-.64.24-1.36.41-2.43.46-1.07.05-1.42.06-4.12.06s-3.05-.01-4.12-.06c-1.07-.05-1.79-.22-2.43-.46a4.9 4.9 0 0 1-1.76-1.15 4.9 4.9 0 0 1-1.15-1.76c-.24-.64-.41-1.36-.46-2.43C2.01 15.05 2 14.7 2 12s.01-3.05.06-4.12c.05-1.07.22-1.79.46-2.43.26-.66.6-1.21 1.15-1.76a4.9 4.9 0 0 1 1.76-1.15c.64-.24 1.36-.41 2.43-.46C8.95 2.01 9.3 2 12 2zm0 1.8c-2.67 0-2.99.01-4.04.06-.87.04-1.34.18-1.66.3-.42.16-.72.36-1.03.67-.31.31-.51.61-.67 1.03-.12.32-.26.79-.3 1.66C4.24 8.75 4.23 9.07 4.23 12s.01 3.24.06 4.28c.04.87.18 1.34.3 1.66.16.42.36.72.67 1.03.31.31.61.51 1.03.67.32.12.79.26 1.66.3 1.05.05 1.36.06 4.04.06s2.99-.01 4.04-.06c.87-.04 1.34-.18 1.66-.3.42-.16.72-.36 1.03-.67.31-.31.51-.61.67-1.03.12-.32.26-.79.3-1.66.05-1.04.06-1.36.06-4.28s-.01-3.24-.06-4.28c-.04-.87-.18-1.34-.3-1.66a2.7 2.7 0 0 0-.67-1.03 2.7 2.7 0 0 0-1.03-.67c-.32-.12-.79-.26-1.66-.3C14.99 3.81 14.67 3.8 12 3.8zm0 3.06a5.14 5.14 0 1 1 0 10.28 5.14 5.14 0 0 1 0-10.28zm0 1.8a3.34 3.34 0 1 0 0 6.68 3.34 3.34 0 0 0 0-6.68zm5.34-1.99a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z',
  },
  {
    label: 'Facebook',
    href: 'https://facebook.com',
    path: 'M13.5 21v-7.5h2.5l.5-3H13.5V8.5c0-.87.24-1.46 1.49-1.46H16.5V4.36C16.24 4.32 15.36 4.25 14.33 4.25c-2.15 0-3.62 1.31-3.62 3.72V10.5H8.2v3h2.51V21h2.79z',
  },
  {
    label: 'TikTok',
    href: 'https://tiktok.com',
    path: 'M16.6 5.82c-.78-.68-1.3-1.62-1.44-2.68h-2.72v13.16c0 .18 0 .36-.03.53a2.6 2.6 0 1 1-1.83-2.63V11.1a5.4 5.4 0 0 0-1.02-.1 5.44 5.44 0 1 0 5.44 5.44V9.7a8.13 8.13 0 0 0 4.6 1.42V8.4c-.98 0-1.94-.29-2.75-.83-.4-.26-.86-.56-.25-1.75z',
  },
];
---

<footer class="bg-[#12121F] text-gray-300 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">

      <!-- Marca -->
      <div class="sm:col-span-2 lg:col-span-1">
        <Logo size={56} variant="light" />
        <p class="text-sm text-gray-400 leading-relaxed mt-4 max-w-xs">
          Organizamos bodas, cumpleaños, eventos corporativos y reuniones sociales
          con elegancia y atención al detalle.
        </p>
        <div class="flex gap-3 mt-6">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="w-9 h-9 rounded-full bg-white/10 hover:bg-[#D4AF37] flex items-center justify-center transition-colors duration-200"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-white">
                <path d={s.path}></path>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Enlaces rapidos -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-sm tracking-wide uppercase">Navegación</h3>
        <ul class="space-y-2.5">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-gray-400 hover:text-[#D4AF37] transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-sm tracking-wide uppercase">Servicios</h3>
        <ul class="space-y-2.5">
          {services.map((service) => (
            <li>
              <a href="#servicios" class="text-sm text-gray-400 hover:text-[#D4AF37] transition-colors duration-200">
                {service}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-white font-semibold mb-4 text-sm tracking-wide uppercase">Contacto</h3>
        <ul class="space-y-2.5 text-sm text-gray-400">
          <li>+51 999 999 999</li>
          <li>contacto@gamevent.com</li>
          <li>Lima, Perú</li>
        </ul>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-500">
        © {currentYear} GamEvent. Todos los derechos reservados.
      </p>
      <p class="text-xs text-gray-500">
        Hecho con dedicación para tus mejores momentos.
      </p>
    </div>
  </div>
</footer>