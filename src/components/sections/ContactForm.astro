---
// src/components/sections/ContactForm.astro
//
// Seccion de contacto: info (telefono, email, ubicacion, redes) +
// formulario. Astro genera un sitio ESTATICO, asi que este <form>
// por si solo no envia nada a ningun lado todavia.
//
// Para que funcione de verdad, mas adelante conecta el `action` del
// form a un servicio gratuito como:
//   - https://web3forms.com  (sin backend, solo necesitas una access key)
//   - https://formspree.io
// O cambia el submit para que redirija a WhatsApp con los datos
// precargados (buena alternativa rapida para negocios locales).

const whatsappNumber = '51999999999'; // <-- reemplaza con el numero real de GamEvent
---

<section id="contacto" class="py-20 lg:py-28 bg-[#1A1A2E]">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">

      <!-- Columna info -->
      <div class="lg:col-span-2">
        <span class="inline-block text-[#D4AF37] text-sm font-semibold tracking-[0.3em] uppercase mb-4">
          Contacto
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-white leading-tight mb-6">
          Hagamos realidad tu evento
        </h2>
        <p class="text-gray-300 leading-relaxed mb-10">
          Cuéntanos qué estás celebrando y te enviamos una cotización sin compromiso.
        </p>

        <ul class="space-y-6">
          <li class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-full bg-white/10 flex items-center justify-center shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <p class="text-white font-medium">Teléfono / WhatsApp</p>
              <p class="text-gray-400 text-sm">+51 999 999 999</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-full bg-white/10 flex items-center justify-center shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2"><path d="M4 4h16v16H4z" opacity="0"/><path d="M22 6l-10 7L2 6"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
            </div>
            <div>
              <p class="text-white font-medium">Correo</p>
              <p class="text-gray-400 text-sm">contacto@gamevent.com</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-full bg-white/10 flex items-center justify-center shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <p class="text-white font-medium">Ubicación</p>
              <p class="text-gray-400 text-sm">Lima, Perú</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Columna formulario -->
      <div class="lg:col-span-3">
        <form id="contact-form" class="bg-white rounded-2xl p-6 sm:p-8 space-y-5">

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="nombre" class="block text-sm font-medium text-gray-700 mb-1.5">Nombre completo</label>
              <input
                type="text" id="nombre" name="nombre" required
                class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#D4AF37] focus:border-transparent"
                placeholder="Tu nombre"
              />
            </div>
            <div>
              <label for="telefono" class="block text-sm font-medium text-gray-700 mb-1.5">Teléfono</label>
              <input
                type="tel" id="telefono" name="telefono" required
                class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#D4AF37] focus:border-transparent"
                placeholder="+51 999 999 999"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">Correo electrónico</label>
            <input
              type="email" id="email" name="email" required
              class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#D4AF37] focus:border-transparent"
              placeholder="tucorreo@ejemplo.com"
            />
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="tipo-evento" class="block text-sm font-medium text-gray-700 mb-1.5">Tipo de evento</label>
              <select
                id="tipo-evento" name="tipo-evento" required
                class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#D4AF37] focus:border-transparent bg-white"
              >
                <option value="">Selecciona una opción</option>
                <option value="boda">Boda</option>
                <option value="cumpleanos">Cumpleaños</option>
                <option value="corporativo">Evento corporativo</option>
                <option value="social">Reunión social</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div>
              <label for="fecha" class="block text-sm font-medium text-gray-700 mb-1.5">Fecha tentativa</label>
              <input
                type="date" id="fecha" name="fecha"
                class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#D4AF37] focus:border-transparent"
              />
            </div>
          </div>

          <div>
            <label for="mensaje" class="block text-sm font-medium text-gray-700 mb-1.5">Cuéntanos sobre tu evento</label>
            <textarea
              id="mensaje" name="mensaje" rows="4" required
              class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#D4AF37] focus:border-transparent resize-none"
              placeholder="Número aproximado de invitados, ubicación, presupuesto estimado..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-[#B8912A] hover:bg-[#9C7A1C] text-white font-semibold tracking-wide px-6 py-3.5 rounded-lg transition-colors duration-200"
          >
            Enviar solicitud
          </button>

          <p id="form-feedback" class="text-sm text-center hidden"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ whatsappNumber }}>
  // NOTA: esto es un placeholder funcional. Al enviar, arma un mensaje
  // con los datos del formulario y abre WhatsApp con el texto precargado.
  // Cuando quieras un envio real por correo, reemplaza este bloque por
  // un fetch() a Web3Forms o Formspree (ver comentario arriba del todo).

  const form = document.getElementById('contact-form');
  const feedback = document.getElementById('form-feedback');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);

    const nombre = data.get('nombre');
    const telefono = data.get('telefono');
    const email = data.get('email');
    const tipoEvento = data.get('tipo-evento');
    const fecha = data.get('fecha') || 'Por definir';
    const mensaje = data.get('mensaje');

    const texto = `Hola GamEvent! Soy ${nombre}.%0A%0ATipo de evento: ${tipoEvento}%0AFecha tentativa: ${fecha}%0ATeléfono: ${telefono}%0ACorreo: ${email}%0A%0AMensaje: ${mensaje}`;

    window.open(`https://wa.me/${whatsappNumber}?text=${texto}`, '_blank');

    feedback?.classList.remove('hidden');
    feedback.textContent = 'Te estamos redirigiendo a WhatsApp para confirmar tu solicitud.';
    feedback.classList.add('text-green-600');
  });
</script>